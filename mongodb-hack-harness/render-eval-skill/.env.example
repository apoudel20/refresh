# Needed by the embedding step and the critic (judge). Get a key at https://openrouter.ai/keys
# render-eval reads OPENROUTER_API_KEY from the environment, or from a .env file in the
# folder you run it from (or any parent folder).
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: the critic model (any OpenRouter vision model). Default: anthropic/claude-opus-5.5
# RENDER_EVAL_JUDGE_MODEL=anthropic/claude-sonnet-5
