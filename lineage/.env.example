# Copy to .env (never commit .env)
MONGODB_URI=mongodb+srv://<user>:<pass>@<hackathon-sandbox-cluster>/   # required to be a finalist
LINEAGE_DB=lineage
OPENROUTER_API_KEY=            # optional: enables LLM-guided agents + generator; blank = heuristic fallback
MODEL=openai/gpt-4o-mini       # any OpenRouter model id
MOCK_DELAY=0.25                # seconds per mock tool call, so runs are watchable
