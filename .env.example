# Copy to .env at the repo root (or wherever you start refresh-server). Never commit .env.

# Agents (every lineage node is one BlenderAgent run) and the main model (lineage generator) run through the
# Claude Code CLI on your Claude subscription: run `claude` then /login (or `claude auth login`) in the terminal
# that starts refresh-server. For a long-lived login instead, run `claude setup-token` and paste the token here.
CLAUDE_CODE_OAUTH_TOKEN=
# Optional path to the CLI if it isn't on PATH (default: `claude`, then ~/.local/bin/claude).
CLAUDE_BIN=
# render-eval critic + embeddings, imagegen fallback: OpenRouter.
OPENROUTER_API_KEY=
# Only for REFRESH_AGENT_BACKEND=anthropic (API billing). Ignored, and hidden from the CLI, with claude_code.
ANTHROPIC_API_KEY=
# MongoDB Atlas: lineage memory, events, agent events, eval vectors. Blank = in-process mongomock.
MONGODB_URI=
LINEAGE_DB=lineage

# Blender: the Blender Lab MCP extension's socket server (Blender 5.1+).
BLENDER_MCP_HOST=localhost
BLENDER_MCP_PORT=9876
BLENDER_MCP_PROTOCOL=lab            # lab | community (blender-mcp add-on)

# Models and budget. Backends: claude_code (default, subscription) | anthropic | openrouter | openai.
REFRESH_AGENT_BACKEND=claude_code
REFRESH_GENERATOR_BACKEND=claude_code
# Opus 5.5 by default; "sonnet" stretches subscription limits further.
REFRESH_AGENT_MODEL=claude-opus-5-5
REFRESH_GENERATOR_MODEL=claude-opus-5-5
REFRESH_AGENT_EFFORT=high
REFRESH_AGENT_MAX_ITERATIONS=6
# Wall-clock cap per agent (seconds).
REFRESH_AGENT_TIMEOUT=1800
REFRESH_GENERATIONS=3
REFRESH_K=3
RENDER_EVAL_JUDGE_MODEL=anthropic/claude-opus-5.5

# imagegen backend for agents' image tools: codex (ChatGPT subscription) | openrouter | openai. Blank = auto.
IMAGEGEN_BACKEND=

# Where runs are stored and the URL the browser uses to reach the API.
REFRESH_WORKSPACE=
REFRESH_PUBLIC_URL=http://localhost:8000
